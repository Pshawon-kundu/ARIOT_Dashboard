SUPABASE_URL=your_project_url
SUPABASE_KEY=your_anon_key
# Backend only. Never use a VITE_ prefix or expose this value to the browser.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
SUPABASE_JWKS_URL=https://your-project-ref.supabase.co/auth/v1/.well-known/jwks.json

# Required only when SUPABASE_URL/JWKS are intentionally omitted for local dev.
# Generate a long random value; there is deliberately no built-in fallback.
DEV_JWT_SECRET=replace_with_a_long_random_development_secret

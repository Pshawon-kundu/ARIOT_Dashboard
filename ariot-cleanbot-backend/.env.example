SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your_anon_key
# Backend only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
SUPABASE_JWKS_URL=https://your-project-ref.supabase.co/auth/v1/.well-known/jwks.json

# Required only when SUPABASE_URL/JWKS are intentionally omitted for local dev.
DEV_JWT_SECRET=replace_with_a_long_random_development_secret

# Simulator URL - Digital Twin service endpoint.
# Local dev: http://127.0.0.1:8100
# Production: https://your-simulator-host.com
SIMULATOR_URL=http://127.0.0.1:8100

# CORS allowed origins - comma-separated list.
# Local dev:
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Production (example):
# CORS_ORIGINS=https://your-frontend.vercel.app
